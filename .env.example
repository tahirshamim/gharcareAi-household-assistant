# GharCare AI configuration.
# 1) Copy this file to ".env"        (PowerShell:  Copy-Item .env.example .env)
# 2) Paste your key below and save   (PowerShell:  notepad .env)
# 3) Check it:                        python -m gharcare.doctor
#
# NEVER commit ".env" or share it: it holds your secret key. (.gitignore already excludes it.)
# Lines starting with # are comments. Empty values are ignored.

# ---------------- LLM ----------------
# Provider: gemini (free API key) or ollama (local, no key)
GHARCARE_LLM_PROVIDER=gemini

# Paste your key from Google AI Studio on the next line (no quotes, no spaces):
GEMINI_API_KEY=

# Model name: pick a CURRENT Flash model in Google AI Studio (names change often), e.g. paste it here:
GHARCARE_LLM_MODEL=

# Requests per minute GharCare allows itself (calls are spaced out so the free tier never rejects them).
# Default for Gemini is 12 (free tier limit is ~15). Set 0 to turn pacing off on a paid tier.
# GHARCARE_LLM_RPM=12

# ---------------- Retrieval ----------------
# Start with these two (no downloads, works offline, lexical baseline only):
GHARCARE_EMBEDDER=hashing
GHARCARE_VECTOR_STORE=memory
# For real semantic search (needs: pip install -r requirements-rag.txt), switch to:
#   GHARCARE_EMBEDDER=sentence-transformers
#   GHARCARE_VECTOR_STORE=chroma
#   GHARCARE_EMBEDDING_MODEL=intfloat/multilingual-e5-small

# ---------------- Storage ----------------
GHARCARE_DATA_DIR=./data
GHARCARE_MAX_UPLOAD_MB=20

# Optional: silence Hugging Face warnings on Windows
HF_HUB_DISABLE_SYMLINKS_WARNING=1

# ---------------- Web app ----------------
# Who the single local user is (letters, digits, - or _):
GHARCARE_USER_ID=demo
# Optional access token. REQUIRED if you listen on anything other than this computer. Leave empty for local-only use.
GHARCARE_APP_TOKEN=
GHARCARE_HOST=127.0.0.1
GHARCARE_PORT=8000
